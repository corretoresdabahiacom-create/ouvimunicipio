rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} { allow read, write: if false; }

    // Anexos: uploads/{uid do autor}/{número do protocolo}/{arquivo}
    match /uploads/{uid}/{numero}/{arquivo} {
      function verificado() { return request.auth != null && request.auth.token.email_verified == true; }
      function meuEmail()   { return request.auth.token.email; }
      function protocolo()  { return firestore.get(/databases/(default)/documents/protocolos/$(numero)).data; }
      function servidorDaSecretaria() {
        return firestore.exists(/databases/(default)/documents/equipe/$(meuEmail()))
          && firestore.get(/databases/(default)/documents/equipe/$(meuEmail())).data.ativo == true
          && firestore.get(/databases/(default)/documents/equipe/$(meuEmail())).data.papel in ['secretario', 'assessor']
          && firestore.get(/databases/(default)/documents/equipe/$(meuEmail())).data.secretariaId == protocolo().secretariaId;
      }

      // Limites reduzidos: imagem até 2 MB (o app comprime antes de enviar) e vídeo até 15 MB.
      function tipoETamanhoOk() {
        return (request.resource.contentType.matches('image/(jpeg|png|webp)') && request.resource.size <= 2 * 1024 * 1024)
            || (request.resource.contentType.matches('video/(mp4|webm)') && request.resource.size <= 15 * 1024 * 1024);
      }

      // Envio: só o dono, antes de o protocolo existir; depois disso os anexos ficam imutáveis.
      allow create: if verificado() && request.auth.uid == uid && tipoETamanhoOk()
        && arquivo.matches('[A-Za-z0-9._-]{1,100}')
        && numero.matches('OUV-[0-9]{4}-[A-Z0-9]{8}')
        && !firestore.exists(/databases/(default)/documents/protocolos/$(numero));

      // Leitura: o autor ou servidor da secretaria destinatária.
      allow read: if verificado() && (
        request.auth.uid == uid ||
        (firestore.exists(/databases/(default)/documents/protocolos/$(numero)) && servidorDaSecretaria())
      );
      allow update, delete: if false;
    }
  }
}
