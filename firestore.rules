rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Padrão: tudo negado.
    match /{document=**} { allow read, write: if false; }

    // ---------- SUPERADMIN (dono do SaaS) ----------
    // Cadastrado só no console do Firebase (ninguém se promove pelo app). Cria/suspende municípios e o 1º admin de cada um.
    // NÃO lê protocolos, conversas, mídias, histórico nem usuários de nenhum município.
    function superadmin() {
      return request.auth != null && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/superadmins/$(request.auth.token.email));
    }
    match /superadmins/{email} {
      allow read: if superadmin() && request.auth.token.email == email;
      allow write: if false;
    }

    // ---------- municípios ----------
    function ufOk(v) { return v in ['AC','AL','AP','AM','BA','CE','DF','ES','GO','MA','MT','MS','MG','PA','PB','PR','PE','PI','RJ','RN','RS','RO','RR','SC','SP','SE','TO']; }
    function cidadeOk(v) { return v is string && v.size() >= 2 && v.size() <= 80; }
    // O ID é o "slug" do endereço (ex.: /itabuna). Tudo de um município fica DENTRO do caminho dele.
    match /municipios/{mid} {
      allow get: if true;           // nome e situação (ativo) aparecem antes do login
      allow list: if superadmin();
      allow create: if superadmin() && mid.matches('[a-z0-9-]{2,40}')
        && request.resource.data.keys().hasOnly(['nome', 'cidade', 'uf', 'ativo', 'plano', 'criadoEm'])
        && cidadeOk(request.resource.data.cidade) && ufOk(request.resource.data.uf)
        && request.resource.data.nome is string && request.resource.data.nome.size() >= 2 && request.resource.data.nome.size() <= 120
        && request.resource.data.ativo is bool
        && request.resource.data.plano in ['basico', 'padrao', 'completo']
        && request.resource.data.criadoEm == request.time;
      // editar nome/plano, suspender/reativar, ou EXCLUIR. Excluir é definitivo pelo app: o município fica desativado,
      // some da lista e o endereço nunca mais pode ser reusado (senão um novo município herdaria os dados do antigo).
      // Os dados só são apagados de vez pelo script scripts/apagar-municipio.mjs.
      allow update: if superadmin()
        && resource.data.get('excluido', false) == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'cidade', 'uf', 'ativo', 'plano', 'excluido', 'excluidoEm'])
        && (!('cidade' in request.resource.data) || cidadeOk(request.resource.data.cidade))
        && (!('uf' in request.resource.data) || ufOk(request.resource.data.uf))
        && request.resource.data.nome is string && request.resource.data.nome.size() >= 2 && request.resource.data.nome.size() <= 120
        && request.resource.data.ativo is bool
        && request.resource.data.plano in ['basico', 'padrao', 'completo']
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['excluido', 'excluidoEm'])
            || (request.resource.data.excluido == true && request.resource.data.ativo == false
                && request.resource.data.excluidoEm == request.time));
      allow delete: if false;

    // ---------- helpers ----------
    function logado()     { return request.auth != null; }
    // O município (mid) vem do caminho. Ele só existe se o SUPERADMIN o criou, e só aceita escrita de cidadãos se estiver ativo.
    function municipioAtivo() {
      return get(/databases/$(database)/documents/municipios/$(mid)).data.get('ativo', false) == true;
    }
    // e-mail confirmado (sem checar bloqueio)
    function basico()     { return logado() && request.auth.token.email_verified == true; }
    // conta liberada: e-mail confirmado e NÃO bloqueada/excluída pelo admin
    function situacaoOk() {
      return !exists(/databases/$(database)/documents/municipios/$(mid)/users/$(request.auth.uid))
        || get(/databases/$(database)/documents/municipios/$(mid)/users/$(request.auth.uid)).data.get('situacao', 'ativo') == 'ativo';
    }
    function verificado() { return basico() && situacaoOk(); }
    // aceitou os termos de uso / política de privacidade (obrigatório para enviar mensagens)
    function termosOk() {
      return get(/databases/$(database)/documents/municipios/$(mid)/users/$(request.auth.uid)).data.get('aceiteVersao', '') != '';
    }
    function meuEmail()   { return request.auth.token.email; }
    // Perfil do usuário como ficará DEPOIS do lote (usado no limite de envios).
    function meuPerfilDepois() { return getAfter(/databases/$(database)/documents/municipios/$(mid)/users/$(request.auth.uid)).data; }
    function docEquipe()  { return get(/databases/$(database)/documents/municipios/$(mid)/equipe/$(meuEmail())).data; }
    function naEquipe() {
      return verificado()
        && exists(/databases/$(database)/documents/municipios/$(mid)/equipe/$(meuEmail()))
        && docEquipe().ativo == true;
    }
    function ehAdmin()    { return naEquipe() && docEquipe().papel == 'admin'; }
    function ehServidor() { return naEquipe() && docEquipe().papel in ['secretario', 'assessor']; }
    function ehOuvidor()  { return naEquipe() && docEquipe().papel == 'ouvidor'; }
    function ehPrefeito() { return naEquipe() && docEquipe().papel == 'prefeito'; }
    function minhaSecretaria() { return docEquipe().secretariaId; }
    // Local da ocorrência (opcional). Exato só na 1ª mensagem (conversa protegida); no protocolo, aproximado (3 casas ≈ 100 m).
    function coordOk(c) {
      return c is map && c.keys().hasOnly(['lat', 'lng']) && c.keys().hasAll(['lat', 'lng'])
        && c.lat is number && c.lng is number
        && c.lat >= -90 && c.lat <= 90 && c.lng >= -180 && c.lng <= 180;
    }
    function aproximadoOk(c) {
      return coordOk(c)
        && math.abs(c.lat * 1000 - math.round(c.lat * 1000)) < 0.01
        && math.abs(c.lng * 1000 - math.round(c.lng * 1000)) < 0.01;
    }

    // ---------- perfil do usuário ----------
    // Cada pessoa lê/edita só o seu (nome, telefone opcional). O admin lê a lista e pode
    // bloquear, desbloquear ou "excluir" (anonimiza e bloqueia para sempre) – nunca edita dados pessoais.
    function telefoneOk(d) {
      return !d.keys().hasAny(['telefone']) || (d.telefone is string && d.telefone.matches('[0-9]{10,13}'));
    }
    function aceiteOk(d) {
      return !d.keys().hasAny(['aceiteVersao', 'aceiteEm'])
        || (d.aceiteVersao is string && d.aceiteVersao.size() <= 20 && d.aceiteEm == request.time);
    }
    match /users/{uid} {
      allow read: if basico() && (request.auth.uid == uid || ehAdmin());
      allow create: if basico() && municipioAtivo() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome', 'telefone', 'email', 'criadoEm', 'situacao', 'aceiteEm', 'aceiteVersao'])
        && aceiteOk(request.resource.data)
        && request.resource.data.situacao == 'ativo'
        && request.resource.data.email == meuEmail()
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 120
        && request.resource.data.criadoEm == request.time
        && telefoneOk(request.resource.data);
      // o próprio usuário (só se a conta estiver ativa)
      allow update: if basico() && request.auth.uid == uid
        && resource.data.get('situacao', 'ativo') == 'ativo'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'telefone', 'email', 'aceiteEm', 'aceiteVersao'])
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 120
        && request.resource.data.email == meuEmail()
        && telefoneOk(request.resource.data)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['aceiteEm', 'aceiteVersao'])
            || (request.resource.data.aceiteVersao is string && request.resource.data.aceiteVersao.size() <= 20 && request.resource.data.aceiteEm == request.time))
        ||
      // o próprio usuário exclui a conta: apaga nome/e-mail/telefone e fica "excluído" (depois o app remove o login)
        basico() && request.auth.uid == uid
        && resource.data.get('situacao', 'ativo') == 'ativo'
        && request.resource.data.situacao == 'excluido'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['situacao', 'nome', 'email', 'telefone'])
        && request.resource.data.nome == '(removido)' && request.resource.data.email == ''
        && !request.resource.data.keys().hasAny(['telefone'])
        ||
      // limite de envios: o cidadão soma 1 envio por mensagem/complemento (máx. 20 a cada 24 h, janela fixa
      // que começa no 1º envio). O contador só sobe de 1 em 1 e não pode ser zerado antes de 24 h.
        basico() && request.auth.uid == uid
        && resource.data.get('situacao', 'ativo') == 'ativo'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['envios', 'janelaEm', 'ultimoEnvio'])
        && request.resource.data.ultimoEnvio is string && request.resource.data.ultimoEnvio.size() <= 40
        && (
          // nova janela
          ((!('janelaEm' in resource.data) || resource.data.janelaEm <= request.time - duration.value(1, 'd'))
            && request.resource.data.envios == 1 && request.resource.data.janelaEm == request.time)
          ||
          // mesma janela: +1, no máximo 20
          (('janelaEm' in resource.data) && resource.data.janelaEm > request.time - duration.value(1, 'd')
            && request.resource.data.janelaEm == resource.data.janelaEm
            && request.resource.data.envios == resource.data.get('envios', 0) + 1
            && request.resource.data.envios <= 20)
        )
        ||
      // o administrador: bloquear/desbloquear, ou excluir (apaga nome/e-mail/telefone e bloqueia de vez)
        ehAdmin() && uid != request.auth.uid
        && resource.data.get('situacao', 'ativo') != 'excluido'
        && request.resource.data.situacao in ['ativo', 'bloqueado', 'excluido']
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['situacao'])
          || (request.resource.data.situacao == 'excluido'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['situacao', 'nome', 'email', 'telefone'])
              && request.resource.data.nome == '(removido)' && request.resource.data.email == ''
              && !request.resource.data.keys().hasAny(['telefone']))
        );
      allow delete: if false;
    }

    // ---------- equipe: admin, secretários e assessores (cadastrados pelo admin) ----------
    // O ID do documento é o e-mail em minúsculas. A pessoa se cadastra normalmente,
    // confirma o e-mail e, se estiver aqui e ativa, ganha o papel correspondente.
    match /equipe/{email} {
      allow read: if verificado() && (ehAdmin() || meuEmail() == email || superadmin());
      // o SUPERADMIN só cadastra administradores do município (nunca o próprio e-mail); o resto é do admin do município
      allow create, update: if superadmin() && email != meuEmail()
        && request.resource.data.keys().hasOnly(['nome', 'papel', 'ativo'])
        && request.resource.data.nome is string && request.resource.data.nome.size() >= 2 && request.resource.data.nome.size() <= 120
        && request.resource.data.papel == 'admin' && request.resource.data.ativo is bool;
      allow create, update: if ehAdmin()
        && request.resource.data.keys().hasOnly(['nome', 'papel', 'secretariaId', 'ativo'])
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 120
        && request.resource.data.papel in ['admin', 'secretario', 'assessor', 'ouvidor', 'prefeito']
        && request.resource.data.ativo is bool
        && (request.resource.data.papel in ['admin', 'ouvidor', 'prefeito'] || (
              request.resource.data.secretariaId is string
              && exists(/databases/$(database)/documents/municipios/$(mid)/secretarias/$(request.resource.data.secretariaId))))
        // o admin não pode se rebaixar nem se desativar (evita ficar sem administrador)
        && (email != meuEmail() || (request.resource.data.papel == 'admin' && request.resource.data.ativo == true));
      allow delete: if ehAdmin() && email != meuEmail();
    }

    // ---------- secretarias ----------
    match /secretarias/{id} {
      allow read: if verificado();
      allow create, update: if ehAdmin()
        && request.resource.data.keys().hasOnly(['nome', 'ativa'])
        && request.resource.data.nome is string && request.resource.data.nome.size() >= 2 && request.resource.data.nome.size() <= 120
        && request.resource.data.ativa is bool;
      allow delete: if ehAdmin();
    }

    // ---------- protocolos ----------
    // O documento guarda só METADADOS (número, tipo, secretaria, status, datas, nota). Por isso o
    // administrador pode ler para estatísticas, sem ver textos nem anexos. O ID é o número do protocolo.
    // criadoEm é sempre o horário do servidor; prazo = criadoEm + 30 dias (calculado na leitura).
    function prazoApagarVencido(p) {
      return p.status == 'concluido' && request.time >= p.concluidoEm + duration.value(30, 'd');
    }
    match /protocolos/{numero} {
      allow get, list: if verificado() && (
        resource.data.autorUid == request.auth.uid ||
        (ehServidor() && resource.data.secretariaId == minhaSecretaria()) ||
        ehAdmin() || ehOuvidor()
      );

      allow create: if verificado() && termosOk() && municipioAtivo()
        && numero.matches('OUV-[0-9]{4}-[A-Z0-9]{8}')
        && request.resource.data.keys().hasOnly(
             ['numero', 'autorUid', 'secretariaId', 'secretariaNome', 'tipo', 'status', 'criadoEm', 'ultimaMsgPor', 'regiao'])
        && (!('regiao' in request.resource.data) || aproximadoOk(request.resource.data.regiao))
        && request.resource.data.numero == numero
        && request.resource.data.autorUid == request.auth.uid
        && request.resource.data.tipo in ['reclamacao', 'denuncia', 'solicitacao', 'sugestao', 'elogio', 'informacao']
        && request.resource.data.status == 'aberto'
        && request.resource.data.ultimaMsgPor == 'cidadao'
        && request.resource.data.criadoEm == request.time
        && meuPerfilDepois().get('ultimoEnvio', '') == numero
        && get(/databases/$(database)/documents/municipios/$(mid)/secretarias/$(request.resource.data.secretariaId)).data.ativa == true
        && request.resource.data.secretariaNome ==
           get(/databases/$(database)/documents/municipios/$(mid)/secretarias/$(request.resource.data.secretariaId)).data.nome;

      allow update: if verificado() && (
        // servidor da secretaria responde (a 1ª resposta marca "respondido" e a data)
        (ehServidor() && resource.data.secretariaId == minhaSecretaria()
          && resource.data.status in ['aberto', 'respondido']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondidoEm', 'ultimaMsgPor'])
          && request.resource.data.status == 'respondido'
          && request.resource.data.ultimaMsgPor == 'servidor'
          && request.resource.data.respondidoEm == (resource.data.status == 'aberto' ? request.time : resource.data.respondidoEm))
        ||
        // cidadão complementa a conversa
        (resource.data.autorUid == request.auth.uid
          && resource.data.status in ['aberto', 'respondido']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimaMsgPor'])
          && request.resource.data.ultimaMsgPor == 'cidadao')
        ||
        // concluir (cidadão ou servidor, depois da 1ª resposta); só o cidadão pode dar nota (1 a 5), uma vez
        ((resource.data.autorUid == request.auth.uid || (ehServidor() && resource.data.secretariaId == minhaSecretaria()))
          && resource.data.status == 'respondido'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'concluidoEm', 'avaliacao'])
          && request.resource.data.status == 'concluido'
          && request.resource.data.concluidoEm == request.time
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['avaliacao'])
              || (resource.data.autorUid == request.auth.uid && !resource.data.keys().hasAny(['avaliacao'])
                  && request.resource.data.avaliacao is int
                  && request.resource.data.avaliacao >= 1 && request.resource.data.avaliacao <= 5)))
        ||
        // nota depois de respondido/concluído (uma única vez, só o autor)
        (resource.data.autorUid == request.auth.uid
          && resource.data.status in ['respondido', 'concluido']
          && !resource.data.keys().hasAny(['avaliacao'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avaliacao'])
          && request.resource.data.avaliacao is int && request.resource.data.avaliacao >= 1 && request.resource.data.avaliacao <= 5)
        ||
        // o servidor prorroga o prazo UMA única vez (Lei 13.460/2017, art. 16): +30 dias, com justificativa,
        // só antes da 1ª resposta e antes de vencer. Registra o nome do servidor e a data (servidor, não do aparelho).
        (ehServidor() && resource.data.secretariaId == minhaSecretaria()
          && resource.data.status == 'aberto'
          && !resource.data.keys().hasAny(['prorrogadoEm'])
          && request.time <= resource.data.criadoEm + duration.value(30, 'd')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prorrogadoEm', 'prorrogacaoMotivo', 'prorrogacaoPor'])
          && request.resource.data.prorrogadoEm == request.time
          && request.resource.data.prorrogacaoMotivo is string
          && request.resource.data.prorrogacaoMotivo.size() >= 10 && request.resource.data.prorrogacaoMotivo.size() <= 300
          && request.resource.data.prorrogacaoPor == docEquipe().nome)
        ||
        // o OUVIDOR GERAL encaminha o protocolo a outra secretaria. Cada encaminhamento gera, no mesmo lote,
        // um registro imutável em historico/h{n} (n = encaminhamentos). Só enquanto a conversa está ativa.
        (ehOuvidor() && resource.data.status in ['aberto', 'respondido']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['secretariaId', 'secretariaNome', 'encaminhadoEm', 'encaminhamentos'])
          && request.resource.data.secretariaId != resource.data.secretariaId
          && request.resource.data.encaminhadoEm == request.time
          && request.resource.data.encaminhamentos == resource.data.get('encaminhamentos', 0) + 1
          && request.resource.data.encaminhamentos <= 20
          && get(/databases/$(database)/documents/municipios/$(mid)/secretarias/$(request.resource.data.secretariaId)).data.ativa == true
          && request.resource.data.secretariaNome ==
             get(/databases/$(database)/documents/municipios/$(mid)/secretarias/$(request.resource.data.secretariaId)).data.nome
          && existsAfter(/databases/$(database)/documents/municipios/$(mid)/protocolos/$(numero)/historico/$('h' + string(request.resource.data.encaminhamentos))))
        ||
        // cobrança interna do ouvidor ao setor (o cidadão não vê); só em protocolo ainda sem resposta
        (ehOuvidor() && resource.data.status == 'aberto'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cobradoEm'])
          && request.resource.data.cobradoEm == request.time)
        ||
        // marca que a conversa já foi apagada (só depois de 30 dias de concluído)
        ((resource.data.autorUid == request.auth.uid || (ehServidor() && resource.data.secretariaId == minhaSecretaria()))
          && prazoApagarVencido(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['apagada'])
          && request.resource.data.apagada == true)
      );

      allow delete: if false;

      // Conversa: só o autor e a secretaria destinatária leem. ID m00…m49 (máx. 50 mensagens).
      // m00 nasce junto com o protocolo (mesmo lote). Mensagens são imutáveis.
      match /mensagens/{msg} {
        function pai() { return get(/databases/$(database)/documents/municipios/$(mid)/protocolos/$(numero)).data; }
        function participante() {
          return pai().autorUid == request.auth.uid
            || (ehServidor() && pai().secretariaId == minhaSecretaria());
        }
        // o ouvidor geral lê as conversas (apenas leitura) para encaminhar ao setor responsável
        allow read: if verificado() && (participante() || ehOuvidor());
        allow create: if verificado() && termosOk()
          && municipioAtivo() && msg.matches('m[0-4][0-9]')
          && request.resource.data.keys().hasOnly(['de', 'autorUid', 'texto', 'assunto', 'anexos', 'criadoEm', 'local'])
          && (!('local' in request.resource.data) || (msg == 'm00' && coordOk(request.resource.data.local)))
          && request.resource.data.autorUid == request.auth.uid
          && request.resource.data.criadoEm == request.time
          && request.resource.data.texto is string && request.resource.data.texto.size() >= 1 && request.resource.data.texto.size() <= 5000
          && request.resource.data.anexos is list && request.resource.data.anexos.size() <= 5
          && (
            (msg == 'm00' && request.resource.data.de == 'cidadao'
              && request.resource.data.assunto is string && request.resource.data.assunto.size() >= 3 && request.resource.data.assunto.size() <= 120
              && getAfter(/databases/$(database)/documents/municipios/$(mid)/protocolos/$(numero)).data.autorUid == request.auth.uid
              && getAfter(/databases/$(database)/documents/municipios/$(mid)/protocolos/$(numero)).data.criadoEm == request.time)
            ||
            (msg != 'm00' && !request.resource.data.keys().hasAny(['assunto'])
              && pai().status in ['aberto', 'respondido']
              && ((request.resource.data.de == 'cidadao' && pai().autorUid == request.auth.uid
                    && meuPerfilDepois().get('ultimoEnvio', '') == numero + '/' + msg)
                  || (request.resource.data.de == 'servidor' && ehServidor() && pai().secretariaId == minhaSecretaria())))
          );
        allow update: if false;
        allow delete: if verificado() && participante() && prazoApagarVencido(pai());
      }

      // Mídias (imagens comprimidas e vídeos curtos) em partes, sem Storage.
      // k = "<mensagem 00-49>_<anexo 0-4>_<parte 0-11>"; só nascem junto com a mensagem (mesmo lote), do mesmo autor.
      match /midias/{k} {
        function paiM() { return get(/databases/$(database)/documents/municipios/$(mid)/protocolos/$(numero)).data; }
        allow read: if verificado() && (
          paiM().autorUid == request.auth.uid ||
          (ehServidor() && paiM().secretariaId == minhaSecretaria()) ||
          ehOuvidor()
        );
        allow create: if basico()
          && k.matches('[0-4][0-9]_[0-4]_([0-9]|1[01])')
          && getAfter(/databases/$(database)/documents/municipios/$(mid)/protocolos/$(numero)/mensagens/$('m' + k.split('_')[0])).data.autorUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/municipios/$(mid)/protocolos/$(numero)/mensagens/$('m' + k.split('_')[0])).data.criadoEm == request.time
          && request.resource.data.keys().hasOnly(['k', 'mime', 'data'])
          && request.resource.data.k == k
          && request.resource.data.mime.matches('(image/(jpeg|png|webp)|video/(mp4|webm|quicktime))')
          && request.resource.data.data is string
          && request.resource.data.data.size() > 0 && request.resource.data.data.size() <= 940000;
        allow update: if false;
        allow delete: if verificado() && (
          paiM().autorUid == request.auth.uid || (ehServidor() && paiM().secretariaId == minhaSecretaria())
        ) && prazoApagarVencido(paiM());
      }
      // Histórico de encaminhamentos: criado só pelo ouvidor geral, junto com o encaminhamento (mesmo lote), imutável.
      // Lê: o autor, a secretaria que está com o protocolo e o ouvidor.
      match /historico/{hid} {
        function paiH() { return get(/databases/$(database)/documents/municipios/$(mid)/protocolos/$(numero)).data; }
        allow read: if verificado() && (
          paiH().autorUid == request.auth.uid ||
          (ehServidor() && paiH().secretariaId == minhaSecretaria()) ||
          ehOuvidor()
        );
        allow create: if ehOuvidor()
          && hid.matches('h([1-9]|1[0-9]|20)')
          && request.resource.data.keys().hasOnly(['de', 'deNome', 'para', 'paraNome', 'por', 'motivo', 'criadoEm'])
          && request.resource.data.criadoEm == request.time
          && request.resource.data.por == docEquipe().nome
          && request.resource.data.motivo is string
          && request.resource.data.motivo.size() >= 5 && request.resource.data.motivo.size() <= 300
          && request.resource.data.de == paiH().secretariaId
          && request.resource.data.deNome == paiH().secretariaNome
          && request.resource.data.para != request.resource.data.de
          && getAfter(/databases/$(database)/documents/municipios/$(mid)/protocolos/$(numero)).data.secretariaId == request.resource.data.para
          && getAfter(/databases/$(database)/documents/municipios/$(mid)/protocolos/$(numero)).data.secretariaNome == request.resource.data.paraNome
          && getAfter(/databases/$(database)/documents/municipios/$(mid)/protocolos/$(numero)).data.encaminhadoEm == request.time
          && hid == 'h' + string(getAfter(/databases/$(database)/documents/municipios/$(mid)/protocolos/$(numero)).data.encaminhamentos);
        allow update, delete: if false;
      }
    }

    // ---------- consulta pública do protocolo pelo número (sem login) ----------
    // Ficha mínima: situação, secretaria e datas. Sem nome, tipo, texto ou nota. As regras exigem que seja uma CÓPIA FIEL
    // do protocolo (getAfter), então ninguém consegue publicar uma situação falsa; quem grava é quem mexe no protocolo.
    // O número tem 8 caracteres aleatórios (32^8 combinações): só quem recebeu o número consegue consultar.
    match /consulta/{numero} {
      function espelhoOk() {
        let p = getAfter(/databases/$(database)/documents/municipios/$(mid)/protocolos/$(numero)).data;
        return request.resource.data.keys().hasOnly(['status', 'secretariaNome', 'criadoEm', 'respondidoEm', 'concluidoEm', 'prorrogadoEm'])
          && request.resource.data.status == p.status
          && request.resource.data.secretariaNome == p.secretariaNome
          && request.resource.data.criadoEm == p.criadoEm
          && request.resource.data.get('respondidoEm', null) == p.get('respondidoEm', null)
          && request.resource.data.get('concluidoEm', null) == p.get('concluidoEm', null)
          && request.resource.data.get('prorrogadoEm', null) == p.get('prorrogadoEm', null);
      }
      allow get: if true;
      allow list: if false;
      allow create, update: if verificado() && espelhoOk();
      allow delete: if false;
    }

    // ---------- respostas-modelo da secretaria ----------
    // Textos prontos que a equipe da secretaria usa nas respostas. Só a própria secretaria lê; só o secretário edita.
    match /modelos/{id} {
      function secretarioDaqui() { return ehServidor() && docEquipe().papel == 'secretario'; }
      function camposModeloOk() {
        return request.resource.data.keys().hasOnly(['secretariaId', 'titulo', 'texto', 'atualizadoEm'])
          && request.resource.data.secretariaId == minhaSecretaria()
          && request.resource.data.titulo is string && request.resource.data.titulo.size() >= 3 && request.resource.data.titulo.size() <= 80
          && request.resource.data.texto is string && request.resource.data.texto.size() >= 1 && request.resource.data.texto.size() <= 5000
          && request.resource.data.atualizadoEm == request.time;
      }
      allow read: if verificado() && ehServidor() && resource.data.secretariaId == minhaSecretaria();
      allow create: if verificado() && secretarioDaqui() && camposModeloOk();
      allow update: if verificado() && secretarioDaqui() && resource.data.secretariaId == minhaSecretaria() && camposModeloOk();
      allow delete: if verificado() && secretarioDaqui() && resource.data.secretariaId == minhaSecretaria();
    }

    // ---------- estatísticas para o prefeito (SOMENTE números, sem dados pessoais) ----------
    // O ouvidor (ou o admin) publica um resumo agregado calculado a partir dos metadados dos protocolos.
    // O prefeito lê só este documento: nunca protocolos, conversas, anexos ou usuários.
    match /estatisticas/{id} {
      // Painel público de transparência: qualquer pessoa lê os números se o admin do município ligou a opção.
      function transparenciaPublica() {
        return exists(/databases/$(database)/documents/municipios/$(mid)/config/site)
          && get(/databases/$(database)/documents/municipios/$(mid)/config/site).data.get('transparencia', false) == true;
      }
      allow get: if id == 'atual' && ((verificado() && (ehPrefeito() || ehOuvidor() || ehAdmin())) || transparenciaPublica());
      allow list: if false;
      allow create, update: if id == 'atual' && (ehOuvidor() || ehAdmin())
        && request.resource.data.keys().hasOnly(['geradoEm', 'geradoPor', 'total', 'porStatus', 'porTipo', 'porSecretaria',
             'porMes', 'vencidas', 'tempoMedioRespostaDias', 'dentroPrazoPct', 'notaMedia', 'avaliacoes'])
        && request.resource.data.geradoEm == request.time
        && request.resource.data.geradoPor == docEquipe().nome
        && request.resource.data.total is int && request.resource.data.vencidas is int && request.resource.data.avaliacoes is int
        && request.resource.data.tempoMedioRespostaDias is number
        && request.resource.data.dentroPrazoPct is number
        && request.resource.data.notaMedia is number
        && request.resource.data.porStatus is map && request.resource.data.porStatus.size() <= 10
        && request.resource.data.porTipo is map && request.resource.data.porTipo.size() <= 10
        && request.resource.data.porSecretaria is map && request.resource.data.porSecretaria.size() <= 100
        && request.resource.data.porMes is map && request.resource.data.porMes.size() <= 60;
      allow delete: if false;
    }

    // ---------- notificações (somente do dono) ----------
    // O app só exibe avisos com expiraEm no futuro (resposta: 24 h) e apaga os vencidos ao abrir.
    match /notificacoes/{id} {
      allow read: if verificado() && resource.data.uid == request.auth.uid;
      allow delete: if verificado() && resource.data.uid == request.auth.uid;

      function camposOk() {
        return request.resource.data.keys().hasOnly(['uid', 'protocoloId', 'tipo', 'mensagem', 'criadoEm', 'expiraEm'])
          && request.resource.data.criadoEm == request.time
          && request.resource.data.mensagem is string && request.resource.data.mensagem.size() <= 500
          && request.resource.data.protocoloId is string;
      }
      function expiraEntre(minimo, maximo) {
        return request.resource.data.expiraEm >= request.time + minimo
            && request.resource.data.expiraEm <= request.time + maximo;
      }

      // "Recebido": criada pelo cidadão junto com o protocolo (mesmo lote). Visível por ~30 dias.
      allow create: if verificado() && camposOk()
        && request.resource.data.tipo == 'recebido'
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/municipios/$(mid)/protocolos/$(request.resource.data.protocoloId)).data.autorUid == request.auth.uid
        && expiraEntre(duration.value(29, 'd'), duration.value(31, 'd'))
        ||
      // "Aviso": mensagem do ADMIN para um usuário (sem protocolo). Dura de 1 a 31 dias.
        ehAdmin() && camposOk()
        && request.resource.data.tipo == 'aviso'
        && request.resource.data.protocoloId == ''
        && request.resource.data.uid is string && request.resource.data.uid.size() > 0
        && expiraEntre(duration.value(1, 'd'), duration.value(31, 'd'))
        ||
      // "Resposta": criada pelo servidor junto com a resposta (mesmo lote). Some em 24 horas (tolerância de ±30 min para o relógio do aparelho).
        ehServidor() && camposOk()
        && request.resource.data.tipo == 'resposta'
        && getAfter(/databases/$(database)/documents/municipios/$(mid)/protocolos/$(request.resource.data.protocoloId)).data.status == 'respondido'
        && getAfter(/databases/$(database)/documents/municipios/$(mid)/protocolos/$(request.resource.data.protocoloId)).data.autorUid == request.resource.data.uid
        && getAfter(/databases/$(database)/documents/municipios/$(mid)/protocolos/$(request.resource.data.protocoloId)).data.secretariaId == minhaSecretaria()
        && expiraEntre(duration.value(1410, 'm'), duration.value(1470, 'm'))
        ||
      // "Prorrogação": o cidadão é comunicado (Lei 13.460/2017). Criada pelo servidor junto com a prorrogação (mesmo lote). Dura ~30 dias.
        ehServidor() && camposOk()
        && request.resource.data.tipo == 'prorrogacao'
        && getAfter(/databases/$(database)/documents/municipios/$(mid)/protocolos/$(request.resource.data.protocoloId)).data.get('prorrogadoEm', null) == request.time
        && getAfter(/databases/$(database)/documents/municipios/$(mid)/protocolos/$(request.resource.data.protocoloId)).data.autorUid == request.resource.data.uid
        && getAfter(/databases/$(database)/documents/municipios/$(mid)/protocolos/$(request.resource.data.protocoloId)).data.secretariaId == minhaSecretaria()
        && expiraEntre(duration.value(29, 'd'), duration.value(31, 'd'));
    }

    // ---------- aparência do site (pública: aparece antes do login) ----------
    function imagemOk(v, max) {
      return v is string && v.size() <= max && v.matches('data:image/(png|jpeg|webp);base64,.*');
    }
    match /config/{id} {
      allow get: if id == 'site';
      allow create, update: if id == 'site' && ehAdmin()
        && request.resource.data.keys().hasOnly(['nome', 'cor', 'logo', 'contato', 'transparencia', 'atualizadoEm'])
        && request.resource.data.get('transparencia', false) is bool
        && request.resource.data.get('contato', '') is string && request.resource.data.get('contato', '').size() <= 120
        && request.resource.data.nome is string && request.resource.data.nome.size() >= 2 && request.resource.data.nome.size() <= 120
        && request.resource.data.cor is string && request.resource.data.cor.matches('#[0-9a-fA-F]{6}')
        && request.resource.data.logo is string
        && (request.resource.data.logo == '' || imagemOk(request.resource.data.logo, 250000))
        && request.resource.data.atualizadoEm == request.time;
      allow delete: if false;
    }

    // ---------- publicidade (carrossel da tela inicial) ----------
    match /anuncios/{id} {
      allow get, list: if resource.data.ativo == true || ehAdmin();
      allow create, update: if ehAdmin()
        && request.resource.data.keys().hasOnly(['titulo', 'link', 'imagem', 'ativo', 'ordem', 'criadoEm'])
        && request.resource.data.titulo is string && request.resource.data.titulo.size() >= 1 && request.resource.data.titulo.size() <= 80
        && request.resource.data.link is string && request.resource.data.link.size() <= 500
        && (request.resource.data.link == '' || request.resource.data.link.matches('https://[^ ]{4,}'))
        && imagemOk(request.resource.data.imagem, 420000)
        && request.resource.data.ativo is bool
        && request.resource.data.ordem is int && request.resource.data.ordem >= 0 && request.resource.data.ordem <= 999
        && request.resource.data.criadoEm is timestamp;
      allow delete: if ehAdmin();
    }

    }
  }
}
