rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Padrão: tudo negado.
    match /{document=**} { allow read, write: if false; }

    // ---------- helpers ----------
    function logado()     { return request.auth != null; }
    // e-mail confirmado (sem checar bloqueio)
    function basico()     { return logado() && request.auth.token.email_verified == true; }
    // conta liberada: e-mail confirmado e NÃO bloqueada/excluída pelo admin
    function situacaoOk() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('situacao', 'ativo') == 'ativo';
    }
    function verificado() { return basico() && situacaoOk(); }
    // aceitou os termos de uso / política de privacidade (obrigatório para enviar mensagens)
    function termosOk() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('aceiteVersao', '') != '';
    }
    function meuEmail()   { return request.auth.token.email; }
    function docEquipe()  { return get(/databases/$(database)/documents/equipe/$(meuEmail())).data; }
    function naEquipe() {
      return verificado()
        && exists(/databases/$(database)/documents/equipe/$(meuEmail()))
        && docEquipe().ativo == true;
    }
    function ehAdmin()    { return naEquipe() && docEquipe().papel == 'admin'; }
    function ehServidor() { return naEquipe() && docEquipe().papel in ['secretario', 'assessor']; }
    function minhaSecretaria() { return docEquipe().secretariaId; }

    // ---------- perfil do usuário ----------
    // Cada pessoa lê/edita só o seu (nome, telefone opcional). O admin lê a lista e pode
    // bloquear, desbloquear ou "excluir" (anonimiza e bloqueia para sempre) – nunca edita dados pessoais.
    function telefoneOk(d) {
      return !d.keys().hasAny(['telefone']) || (d.telefone is string && d.telefone.matches('[0-9]{10,13}'));
    }
    function aceiteOk(d) {
      return !d.keys().hasAny(['aceiteVersao', 'aceiteEm'])
        || (d.aceiteVersao is string && d.aceiteVersao.size() <= 20 && d.aceiteEm == request.time);
    }
    match /users/{uid} {
      allow read: if basico() && (request.auth.uid == uid || ehAdmin());
      allow create: if basico() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome', 'telefone', 'email', 'criadoEm', 'situacao', 'aceiteEm', 'aceiteVersao'])
        && aceiteOk(request.resource.data)
        && request.resource.data.situacao == 'ativo'
        && request.resource.data.email == meuEmail()
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 120
        && request.resource.data.criadoEm == request.time
        && telefoneOk(request.resource.data);
      // o próprio usuário (só se a conta estiver ativa)
      allow update: if basico() && request.auth.uid == uid
        && resource.data.get('situacao', 'ativo') == 'ativo'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'telefone', 'email', 'aceiteEm', 'aceiteVersao'])
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 120
        && request.resource.data.email == meuEmail()
        && telefoneOk(request.resource.data)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['aceiteEm', 'aceiteVersao'])
            || (request.resource.data.aceiteVersao is string && request.resource.data.aceiteVersao.size() <= 20 && request.resource.data.aceiteEm == request.time))
        ||
      // o próprio usuário exclui a conta: apaga nome/e-mail/telefone e fica "excluído" (depois o app remove o login)
        basico() && request.auth.uid == uid
        && resource.data.get('situacao', 'ativo') == 'ativo'
        && request.resource.data.situacao == 'excluido'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['situacao', 'nome', 'email', 'telefone'])
        && request.resource.data.nome == '(removido)' && request.resource.data.email == ''
        && !request.resource.data.keys().hasAny(['telefone'])
        ||
      // o administrador: bloquear/desbloquear, ou excluir (apaga nome/e-mail/telefone e bloqueia de vez)
        ehAdmin() && uid != request.auth.uid
        && resource.data.get('situacao', 'ativo') != 'excluido'
        && request.resource.data.situacao in ['ativo', 'bloqueado', 'excluido']
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['situacao'])
          || (request.resource.data.situacao == 'excluido'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['situacao', 'nome', 'email', 'telefone'])
              && request.resource.data.nome == '(removido)' && request.resource.data.email == ''
              && !request.resource.data.keys().hasAny(['telefone']))
        );
      allow delete: if false;
    }

    // ---------- equipe: admin, secretários e assessores (cadastrados pelo admin) ----------
    // O ID do documento é o e-mail em minúsculas. A pessoa se cadastra normalmente,
    // confirma o e-mail e, se estiver aqui e ativa, ganha o papel correspondente.
    match /equipe/{email} {
      allow read: if verificado() && (ehAdmin() || meuEmail() == email);
      allow create, update: if ehAdmin()
        && request.resource.data.keys().hasOnly(['nome', 'papel', 'secretariaId', 'ativo'])
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 120
        && request.resource.data.papel in ['admin', 'secretario', 'assessor']
        && request.resource.data.ativo is bool
        && (request.resource.data.papel == 'admin' || (
              request.resource.data.secretariaId is string
              && exists(/databases/$(database)/documents/secretarias/$(request.resource.data.secretariaId))))
        // o admin não pode se rebaixar nem se desativar (evita ficar sem administrador)
        && (email != meuEmail() || (request.resource.data.papel == 'admin' && request.resource.data.ativo == true));
      allow delete: if ehAdmin() && email != meuEmail();
    }

    // ---------- secretarias ----------
    match /secretarias/{id} {
      allow read: if verificado();
      allow create, update: if ehAdmin()
        && request.resource.data.keys().hasOnly(['nome', 'ativa'])
        && request.resource.data.nome is string && request.resource.data.nome.size() >= 2 && request.resource.data.nome.size() <= 120
        && request.resource.data.ativa is bool;
      allow delete: if ehAdmin();
    }

    // ---------- protocolos ----------
    // O documento guarda só METADADOS (número, tipo, secretaria, status, datas, nota). Por isso o
    // administrador pode ler para estatísticas, sem ver textos nem anexos. O ID é o número do protocolo.
    // criadoEm é sempre o horário do servidor; prazo = criadoEm + 30 dias (calculado na leitura).
    function prazoApagarVencido(p) {
      return p.status == 'concluido' && request.time >= p.concluidoEm + duration.value(30, 'd');
    }
    match /protocolos/{numero} {
      allow get, list: if verificado() && (
        resource.data.autorUid == request.auth.uid ||
        (ehServidor() && resource.data.secretariaId == minhaSecretaria()) ||
        ehAdmin()
      );

      allow create: if verificado() && termosOk()
        && numero.matches('OUV-[0-9]{4}-[A-Z0-9]{8}')
        && request.resource.data.keys().hasOnly(
             ['numero', 'autorUid', 'secretariaId', 'secretariaNome', 'tipo', 'status', 'criadoEm', 'ultimaMsgPor'])
        && request.resource.data.numero == numero
        && request.resource.data.autorUid == request.auth.uid
        && request.resource.data.tipo in ['reclamacao', 'denuncia', 'solicitacao', 'sugestao', 'elogio', 'informacao']
        && request.resource.data.status == 'aberto'
        && request.resource.data.ultimaMsgPor == 'cidadao'
        && request.resource.data.criadoEm == request.time
        && get(/databases/$(database)/documents/secretarias/$(request.resource.data.secretariaId)).data.ativa == true
        && request.resource.data.secretariaNome ==
           get(/databases/$(database)/documents/secretarias/$(request.resource.data.secretariaId)).data.nome;

      allow update: if verificado() && (
        // servidor da secretaria responde (a 1ª resposta marca "respondido" e a data)
        (ehServidor() && resource.data.secretariaId == minhaSecretaria()
          && resource.data.status in ['aberto', 'respondido']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondidoEm', 'ultimaMsgPor'])
          && request.resource.data.status == 'respondido'
          && request.resource.data.ultimaMsgPor == 'servidor'
          && request.resource.data.respondidoEm == (resource.data.status == 'aberto' ? request.time : resource.data.respondidoEm))
        ||
        // cidadão complementa a conversa
        (resource.data.autorUid == request.auth.uid
          && resource.data.status in ['aberto', 'respondido']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimaMsgPor'])
          && request.resource.data.ultimaMsgPor == 'cidadao')
        ||
        // concluir (cidadão ou servidor, depois da 1ª resposta); só o cidadão pode dar nota (1 a 5), uma vez
        ((resource.data.autorUid == request.auth.uid || (ehServidor() && resource.data.secretariaId == minhaSecretaria()))
          && resource.data.status == 'respondido'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'concluidoEm', 'avaliacao'])
          && request.resource.data.status == 'concluido'
          && request.resource.data.concluidoEm == request.time
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['avaliacao'])
              || (resource.data.autorUid == request.auth.uid && !resource.data.keys().hasAny(['avaliacao'])
                  && request.resource.data.avaliacao is int
                  && request.resource.data.avaliacao >= 1 && request.resource.data.avaliacao <= 5)))
        ||
        // nota depois de respondido/concluído (uma única vez, só o autor)
        (resource.data.autorUid == request.auth.uid
          && resource.data.status in ['respondido', 'concluido']
          && !resource.data.keys().hasAny(['avaliacao'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avaliacao'])
          && request.resource.data.avaliacao is int && request.resource.data.avaliacao >= 1 && request.resource.data.avaliacao <= 5)
        ||
        // marca que a conversa já foi apagada (só depois de 30 dias de concluído)
        ((resource.data.autorUid == request.auth.uid || (ehServidor() && resource.data.secretariaId == minhaSecretaria()))
          && prazoApagarVencido(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['apagada'])
          && request.resource.data.apagada == true)
      );

      allow delete: if false;

      // Conversa: só o autor e a secretaria destinatária leem. ID m00…m49 (máx. 50 mensagens).
      // m00 nasce junto com o protocolo (mesmo lote). Mensagens são imutáveis.
      match /mensagens/{mid} {
        function pai() { return get(/databases/$(database)/documents/protocolos/$(numero)).data; }
        function participante() {
          return pai().autorUid == request.auth.uid
            || (ehServidor() && pai().secretariaId == minhaSecretaria());
        }
        allow read: if verificado() && participante();
        allow create: if verificado() && termosOk()
          && mid.matches('m[0-4][0-9]')
          && request.resource.data.keys().hasOnly(['de', 'autorUid', 'texto', 'assunto', 'anexos', 'criadoEm'])
          && request.resource.data.autorUid == request.auth.uid
          && request.resource.data.criadoEm == request.time
          && request.resource.data.texto is string && request.resource.data.texto.size() >= 1 && request.resource.data.texto.size() <= 5000
          && request.resource.data.anexos is list && request.resource.data.anexos.size() <= 5
          && (
            (mid == 'm00' && request.resource.data.de == 'cidadao'
              && request.resource.data.assunto is string && request.resource.data.assunto.size() >= 3 && request.resource.data.assunto.size() <= 120
              && getAfter(/databases/$(database)/documents/protocolos/$(numero)).data.autorUid == request.auth.uid
              && getAfter(/databases/$(database)/documents/protocolos/$(numero)).data.criadoEm == request.time)
            ||
            (mid != 'm00' && !request.resource.data.keys().hasAny(['assunto'])
              && pai().status in ['aberto', 'respondido']
              && ((request.resource.data.de == 'cidadao' && pai().autorUid == request.auth.uid)
                  || (request.resource.data.de == 'servidor' && ehServidor() && pai().secretariaId == minhaSecretaria())))
          );
        allow update: if false;
        allow delete: if verificado() && participante() && prazoApagarVencido(pai());
      }

      // Mídias (imagens comprimidas e vídeos curtos) em partes, sem Storage.
      // k = "<mensagem 00-49>_<anexo 0-4>_<parte 0-11>"; só nascem junto com a mensagem (mesmo lote), do mesmo autor.
      match /midias/{k} {
        function paiM() { return get(/databases/$(database)/documents/protocolos/$(numero)).data; }
        allow read: if verificado() && (
          paiM().autorUid == request.auth.uid ||
          (ehServidor() && paiM().secretariaId == minhaSecretaria())
        );
        allow create: if basico()
          && k.matches('[0-4][0-9]_[0-4]_([0-9]|1[01])')
          && getAfter(/databases/$(database)/documents/protocolos/$(numero)/mensagens/$('m' + k.split('_')[0])).data.autorUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/protocolos/$(numero)/mensagens/$('m' + k.split('_')[0])).data.criadoEm == request.time
          && request.resource.data.keys().hasOnly(['k', 'mime', 'data'])
          && request.resource.data.k == k
          && request.resource.data.mime.matches('(image/(jpeg|png|webp)|video/(mp4|webm|quicktime))')
          && request.resource.data.data is string
          && request.resource.data.data.size() > 0 && request.resource.data.data.size() <= 940000;
        allow update: if false;
        allow delete: if verificado() && (
          paiM().autorUid == request.auth.uid || (ehServidor() && paiM().secretariaId == minhaSecretaria())
        ) && prazoApagarVencido(paiM());
      }
    }

    // ---------- notificações (somente do dono) ----------
    // O app só exibe avisos com expiraEm no futuro (resposta: 24 h) e apaga os vencidos ao abrir.
    match /notificacoes/{id} {
      allow read: if verificado() && resource.data.uid == request.auth.uid;
      allow delete: if verificado() && resource.data.uid == request.auth.uid;

      function camposOk() {
        return request.resource.data.keys().hasOnly(['uid', 'protocoloId', 'tipo', 'mensagem', 'criadoEm', 'expiraEm'])
          && request.resource.data.criadoEm == request.time
          && request.resource.data.mensagem is string && request.resource.data.mensagem.size() <= 500
          && request.resource.data.protocoloId is string;
      }
      function expiraEntre(minimo, maximo) {
        return request.resource.data.expiraEm >= request.time + minimo
            && request.resource.data.expiraEm <= request.time + maximo;
      }

      // "Recebido": criada pelo cidadão junto com o protocolo (mesmo lote). Visível por ~30 dias.
      allow create: if verificado() && camposOk()
        && request.resource.data.tipo == 'recebido'
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/protocolos/$(request.resource.data.protocoloId)).data.autorUid == request.auth.uid
        && expiraEntre(duration.value(29, 'd'), duration.value(31, 'd'))
        ||
      // "Aviso": mensagem do ADMIN para um usuário (sem protocolo). Dura de 1 a 31 dias.
        ehAdmin() && camposOk()
        && request.resource.data.tipo == 'aviso'
        && request.resource.data.protocoloId == ''
        && request.resource.data.uid is string && request.resource.data.uid.size() > 0
        && expiraEntre(duration.value(1, 'd'), duration.value(31, 'd'))
        ||
      // "Resposta": criada pelo servidor junto com a resposta (mesmo lote). Some em 24 horas (tolerância de ±30 min para o relógio do aparelho).
        ehServidor() && camposOk()
        && request.resource.data.tipo == 'resposta'
        && getAfter(/databases/$(database)/documents/protocolos/$(request.resource.data.protocoloId)).data.status == 'respondido'
        && getAfter(/databases/$(database)/documents/protocolos/$(request.resource.data.protocoloId)).data.autorUid == request.resource.data.uid
        && getAfter(/databases/$(database)/documents/protocolos/$(request.resource.data.protocoloId)).data.secretariaId == minhaSecretaria()
        && expiraEntre(duration.value(1410, 'm'), duration.value(1470, 'm'));
    }

    // ---------- aparência do site (pública: aparece antes do login) ----------
    function imagemOk(v, max) {
      return v is string && v.size() <= max && v.matches('data:image/(png|jpeg|webp);base64,.*');
    }
    match /config/{id} {
      allow get: if id == 'site';
      allow create, update: if id == 'site' && ehAdmin()
        && request.resource.data.keys().hasOnly(['nome', 'cor', 'logo', 'contato', 'atualizadoEm'])
        && request.resource.data.get('contato', '') is string && request.resource.data.get('contato', '').size() <= 120
        && request.resource.data.nome is string && request.resource.data.nome.size() >= 2 && request.resource.data.nome.size() <= 120
        && request.resource.data.cor is string && request.resource.data.cor.matches('#[0-9a-fA-F]{6}')
        && request.resource.data.logo is string
        && (request.resource.data.logo == '' || imagemOk(request.resource.data.logo, 250000))
        && request.resource.data.atualizadoEm == request.time;
      allow delete: if false;
    }

    // ---------- publicidade (carrossel da tela inicial) ----------
    match /anuncios/{id} {
      allow get, list: if resource.data.ativo == true || ehAdmin();
      allow create, update: if ehAdmin()
        && request.resource.data.keys().hasOnly(['titulo', 'link', 'imagem', 'ativo', 'ordem', 'criadoEm'])
        && request.resource.data.titulo is string && request.resource.data.titulo.size() >= 1 && request.resource.data.titulo.size() <= 80
        && request.resource.data.link is string && request.resource.data.link.size() <= 500
        && (request.resource.data.link == '' || request.resource.data.link.matches('https://[^ ]{4,}'))
        && imagemOk(request.resource.data.imagem, 420000)
        && request.resource.data.ativo is bool
        && request.resource.data.ordem is int && request.resource.data.ordem >= 0 && request.resource.data.ordem <= 999
        && request.resource.data.criadoEm is timestamp;
      allow delete: if ehAdmin();
    }
  }
}
