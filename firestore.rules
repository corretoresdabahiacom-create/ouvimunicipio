rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Padrão: tudo negado. Escritas sensíveis só via Cloud Functions (Admin SDK).
    match /{document=**} { allow read, write: if false; }

    function logado()    { return request.auth != null; }
    // Papéis vêm de custom claims definidas só pelo servidor. Exige e-mail confirmado.
    function verificado() { return logado() && request.auth.token.email_verified == true; }
    function papel()     { return request.auth.token.get('role', 'cidadao'); }
    function ehAdmin()   { return verificado() && papel() == 'admin'; }
    function ehServidor() { return verificado() && papel() == 'servidor'; }

    // Perfis: cada pessoa lê só o seu. Admin lê perfis (gestão de servidores), nunca mensagens.
    match /users/{uid} {
      allow read: if verificado() && (request.auth.uid == uid || ehAdmin());
      // Cidadão cria o próprio perfil, sempre como 'cidadao'. Papel nunca é editável pelo cliente.
      allow create: if verificado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome', 'email', 'telefone', 'role', 'ativo', 'criadoEm'])
        && request.resource.data.role == 'cidadao'
        && request.resource.data.ativo == true
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 120;
      allow update: if verificado() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'telefone'])
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 120;
      allow delete: if false;
    }

    // Lista de secretarias (nomes públicos para o formulário). Escrita: só admin via Functions.
    match /secretarias/{id} {
      allow read: if verificado();
      allow write: if false;
    }

    // Protocolos: só o autor e os servidores da secretaria destinatária. Não é público.
    match /protocolos/{id} {
      allow get, list: if verificado() && (
        resource.data.autorUid == request.auth.uid ||
        (ehServidor() && resource.data.secretariaId == request.auth.token.secretariaId)
      );
      allow write: if false; // criar/responder apenas por Functions
    }

    // Notificações: só do próprio usuário e enquanto não expiraram. Limpeza por Function.
    match /notificacoes/{id} {
      allow read: if verificado() && resource.data.uid == request.auth.uid
        && resource.data.expiraEm > request.time;
      allow write: if false;
    }

    // Internos: sem acesso do cliente.
    match /auditoria/{id} { allow read, write: if false; }
    match /limites/{id}   { allow read, write: if false; }
    match /mail/{id}      { allow read, write: if false; }
  }
}
